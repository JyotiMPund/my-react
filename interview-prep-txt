6)Higher Order component:
->A function that takes a component as an argument
->Returns new component that inhances the orignal one
->Doesn't modify the original component directly,but adds functionality to it

Ex-

## Hoc.js

Const Hoc=(WrappedComponent)=>{
return function(){
return(

<div>
<h1>Hello,World</h1>
<Wrappedcomponent/>
</div>
)
}
}
export default Hoc;

## App.js:

import Hoc from "./components/Hoc"

const Greeting=()=>{
return <h1>Good afternoon</h1>
}

const EnhancedComponent=hoc(Greeting);

export default function App(){
return(

<div>
<Enhancedcomponent/>
</div>
)
}
